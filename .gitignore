# ==============================================================================
# Universal Starter Platform — .gitignore
# Secrets & runtime data must NEVER be committed.
# ==============================================================================

# ─── Secrets & local overrides (NEVER commit) ───
.env
config/hosting.php

# ─── Database dumps & local backups (Allow database/ canonical files) ───
*.sqlite
*.sqlite3
*.backup.sql
*_backup_*.sql

# ─── Dev / diagnostics temporary entry points ───
check_db.php
health_check.php
diagnostics_*.php
router_local.php

# ─── Dev helpers, local reports ───
run-windows.bat
run-windows.ps1
run.sh
run.txt
tech_concept_preview.html
tech_sources.txt
/1300

# ─── Archives & data exports ───
*.zip
*.rar
*.7z
/tech_platform_*.json
*.log

# ─── Runtime data (keep dir structure via .gitkeep) ───
storage/cache/*
storage/logs/*
storage/sessions/*
storage/cron_status.json
storage/data/*
!storage/cache/.gitkeep
!storage/logs/.gitkeep
!storage/sessions/.gitkeep
!storage/data/.gitkeep
!storage/data/geoip_db.bin
scratch/

# ─── User uploads are server-side data (keep the security .htaccess) ───
uploads/*
!uploads/.htaccess

# ─── OS / editor junk ───
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
