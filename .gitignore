# ==============================================================================
# AsabTech — .gitignore
# Private repo: code is safe here, but secrets & runtime data must NEVER be committed.
# ==============================================================================

# ── Secrets & local overrides (NEVER commit) ──
.env
config/hosting.php

# ── Database dumps (contain real users, traffic logs, session IDs) ──
*.sql
*.sqlite
*.sqlite3

# ── Dev / diagnostics entry points ──
check_db.php
health_check.php
diagnostics_*.php
dev-router.php
router_local.php

# ── Dev helpers, local reports, previews ──
run-windows.bat
run-windows.ps1
run.sh
run.txt
tech_concept_preview.html
tech_sources.txt
/1300

# ── Root-level notes/reports (the docs/ folder IS committed) ──
/*.md
/*.txt

# ── Archives & data exports ──
*.zip
*.rar
*.7z
/tech_platform_*.json
*.log

# ── Runtime data (keep dir structure via .gitkeep) ──
storage/cache/*
storage/logs/*
storage/sessions/*
storage/cron_status.json
!storage/cache/.gitkeep
!storage/logs/.gitkeep
!storage/sessions/.gitkeep
scratch/

# ── User uploads are server-side data (keep the security .htaccess) ──
uploads/*
!uploads/.htaccess

# ── OS / editor junk ──
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
