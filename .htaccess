# ==============================================================================
# AsabTech - Production Apache / LiteSpeed .htaccess Configuration
# ==============================================================================

Options -Indexes
RewriteEngine On

# 1. Block direct access to sensitive system directories and files
RewriteRule ^(config|core|models|controllers|storage|languages|scratch|\.git)(/|$) - [F,L,NC]

# Allow PWA manifest files while blocking other sensitive JSON/env/config files
RewriteCond %{REQUEST_URI} !^/manifest\.(json|webmanifest)$ [NC]
RewriteRule \.(env|sql|log|bat|sh|md|lock|json)$ - [F,L,NC]

# PWA Service-Worker & Manifest Header Controls
<FilesMatch "^sw\.js$">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType application/javascript .js
    AddType image/svg+xml .svg
</IfModule>

# Block direct access to standalone diagnostic/dev scripts in web root.
# These are disabled in production; use the protected /admin/diagnostics
# suite inside the admin panel instead.
RewriteRule ^(check_db|health_check|diagnostics_hub|diagnostics_database|diagnostics_security|diagnostics_media|diagnostics_seo|dev-router)\.php$ - [F,L,NC]

# 2. Serve physical static assets directly (CSS, JS, Fonts, Images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(assets|uploads)(/|$) - [L]

# 3. Allow existing physical files
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Route all dynamic URIs through index.php
RewriteRule ^ index.php [QSA,L]

# 5. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. GZIP / Deflate Compression for Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 7. Default Charset UTF-8
AddDefaultCharset UTF-8
