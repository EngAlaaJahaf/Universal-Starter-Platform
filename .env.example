# ==============================================================================
# Tech News Platform - Environment Configuration (.env)
# ==============================================================================
# NOTE: this app has NO dotenv loader — it reads REAL environment variables
# via getenv(). A plain ".env" file alone does NOTHING unless your server
# loads it. Two supported options:
#
#   A) Shared hosting without env support (e.g. InfinityFree free):
#      copy config/hosting.example.php → config/hosting.php and fill it in.
#      (git-ignored, upload once manually — never overwritten by auto-deploy)
#
#   B) VPS / hosts with env support: export the variables below.
#
# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tech_news_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Optional: base URL (auto-detected from HTTP_HOST if omitted) ---
# BASE_URL=https://your-domain.com/

# --- Optional: cron secret (must match the ?secret= used by cron jobs) ---
# CRON_SECRET=change-me-to-a-long-random-string

# --- Optional: Brevo transactional HTTP API (preferred on hosts that
# --- block SMTP ports; also configurable from admin → newsletter → SMTP) ---
# BREVO_API_KEY=xkeysib-...

# --- Optional: SMTP outgoing mail ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=news@your-domain.com
# MAIL_FROM_NAME=Tech News Platform

# --- Optional: Web Push (VAPID) ---
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:admin@your-domain.com
