# ==============================================================================
# Universal Starter Platform - Environment Configuration (.env)
# ==============================================================================
# NOTE: this app has NO dotenv loader â€” it reads REAL environment variables
# via getenv(). A plain ".env" file alone does NOTHING unless your server
# loads it. Two supported options:
#
#   A) Shared hosting without env support (e.g. InfinityFree free):
#      copy config/hosting.example.php â†’ config/hosting.php and fill it in.
#      (git-ignored, upload once manually â€” never overwritten by auto-deploy)
#
#   B) VPS / hosts with env support: export the variables below.
#
# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=starter_platform_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Optional: base URL (auto-detected from HTTP_HOST if omitted) ---
# BASE_URL=https://your-domain.com/

# --- Required for HTTP cron access (SH-02): no default exists on purpose.
# --- Generate with: php craft cron:secret
# --- CLI cron runs never need it. Rotate by replacing the value + cron URL.
# CRON_SECRET=paste-64-hex-chars-here

# --- Optional: Brevo transactional HTTP API (preferred on hosts that
# --- block SMTP ports; also configurable from admin â†’ newsletter â†’ SMTP) ---
# BREVO_API_KEY=xkeysib-...

# --- Optional: SMTP outgoing mail ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=news@your-domain.com
# MAIL_FROM_NAME=Universal Starter Platform

# --- Optional: Web Push (VAPID) ---
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:admin@your-domain.com

# --- Optional: REST API v1 security (SH-05) ---
# CORS_ALLOWED_ORIGINS: comma-separated HTTPS origins allowed to read API
# responses cross-origin. Leave EMPTY = same-origin only (fail-secure).
# NEVER use "*". Example:
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com
#
# Rate limiting (requests per window-minutes): per-key and per-IP.
# API_RATE_MAX_PER_KEY=600
# API_RATE_MAX_PER_IP=120
# API_RATE_WINDOW_MIN=1
#
# TRUST_PROXY: set true ONLY behind a fixed trusted proxy/CDN. On raw shared
# hosting leave false (X-Forwarded-For must not be honoured on shared IPs).
# TRUST_PROXY=false

# --- Cache driver (SH-09) ---
# file  = JSON files in storage/cache (default; shared-hosting safe)
# apcu  = in-memory APCu (requires PHP apcu extension; falls back to file)
# array = request-only runtime store (useful for tests)
# CACHE_DRIVER=file

# --- Uptime heartbeat (SH-10) ---
# Optional: URL that cron/health_heartbeat.php pings so an external monitor can
# confirm the crontab is alive. Leave empty for no-op. Example (UptimeRobot):
# UPTIME_HEARTBEAT_URL=https://uptimerobot.com/push/XXXX/YYYY

